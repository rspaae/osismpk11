generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum Role {
  ADMINISTRATOR  @map("administrator")
  KEPALA_SEKOLAH @map("kepala_sekolah")
  KESISWAAN      @map("kesiswaan")
  PEMBINA        @map("pembina")
  BPH_OSIS       @map("bph_osis")
  BPH_MPK        @map("bph_mpk")
  SEKBID_OFFICER @map("sekbid_officer")
  KOMISI_OFFICER @map("komisi_officer")
  STUDENT        @map("student")

  @@map("user_roles")
}

enum Division {
  // OSIS SEKBID 1 - 10
  SEKBID_1  @map("sekbid_1")
  SEKBID_2  @map("sekbid_2")
  SEKBID_3  @map("sekbid_3")
  SEKBID_4  @map("sekbid_4")
  SEKBID_5  @map("sekbid_5")
  SEKBID_6  @map("sekbid_6")
  SEKBID_7  @map("sekbid_7")
  SEKBID_8  @map("sekbid_8")
  SEKBID_9  @map("sekbid_9")
  SEKBID_10 @map("sekbid_10")

  // MPK KOMISI A - D
  KOMISI_A @map("komisi_a")
  KOMISI_B @map("komisi_b")
  KOMISI_C @map("komisi_c")
  KOMISI_D @map("komisi_d")

  // PIMPINAN & UMUM
  BPH_OSIS       @map("bph_osis")
  BPH_MPK        @map("bph_mpk")
  KESISWAAN      @map("kesiswaan")
  PEMBINA        @map("pembina")
  KEPALA_SEKOLAH @map("kepala_sekolah")
  GENERAL        @map("general")

  @@map("organization_divisions")
}

enum OrganizationType {
  SHARED        @map("shared")
  OSIS          @map("osis")
  MPK           @map("mpk")
  DEWAN_PEMBINA @map("dewan_pembina")

  @@map("organization_types")
}

enum Gender {
  MALE   @map("male")
  FEMALE @map("female")

  @@map("user_genders")
}

enum AspirationStatus {
  PENDING   @map("pending")
  IN_REVIEW @map("in_review")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  RESOLVED  @map("resolved")

  @@map("aspiration_statuses")
}

enum ProkerStatus {
  PLANNED   @map("planned")
  ONGOING   @map("ongoing")
  COMPLETED @map("completed")
  EVALUATED @map("evaluated")
  CANCELLED @map("cancelled")

  @@map("proker_statuses")
}

enum PostStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("post_statuses")
}

enum AttendanceType {
  MEETING          @map("meeting") // Rapat Pleno, Rapat BPH, Rapat Sekbid/Komisi
  EVENT            @map("event") // Kegiatan Sekolah, Porseni, LDK, Upacara
  DUTY_PIKET       @map("duty_piket") // Piket Harian Ruang OSIS/MPK
  GENERAL_ASSEMBLY @map("general_assembly") // Sidang Umum & Musyawarah

  @@map("attendance_types")
}

enum AttendanceStatus {
  PRESENT    @map("present") // Hadir tepat waktu
  LATE       @map("late") // Hadir terlambat
  PERMISSION @map("permission") // Izin resmi
  SICK       @map("sick") // Sakit dengan surat/keterangan
  ABSENT     @map("absent") // Tanpa keterangan / Alpa

  @@map("attendance_statuses")
}

enum TaskPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")

  @@map("task_priorities")
}

enum TaskStatus {
  TODO        @map("todo") // Belum dikerjakan
  IN_PROGRESS @map("in_progress") // Sedang berjalan
  SUBMITTED   @map("submitted") // Laporan tugas diserahkan
  COMPLETED   @map("completed") // Terverifikasi selesai

  @@map("task_statuses")
}

enum AuditAction {
  CREATE  @map("create")
  UPDATE  @map("update")
  DELETE  @map("delete")
  LOGIN   @map("login")
  APPROVE @map("approve")
  REJECT  @map("reject")
  VERIFY  @map("verify")

  @@map("audit_actions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 1. ACADEMIC & CABINET PERIOD (PERIODE KEPENGURUSAN MULTI-TAHUN)
// ═══════════════════════════════════════════════════════════════════════════════

model AcademicPeriod {
  id              String    @id @default(cuid())
  name            String // Contoh: "2025/2026"
  yearStart       Int // 2025
  yearEnd         Int // 2026
  cabinetNameOsis String? // Contoh: "Navastra"
  cabinetNameMpk  String? // Contoh: "Navandya"
  theme           String? // Contoh: "Sinergi Aksi, Nyata Berprestasi"
  isActive        Boolean   @default(false)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relasi Data per Periode
  users              User[]
  structureMembers   StructureMember[]
  workPrograms       WorkProgram[]
  attendanceSessions AttendanceSession[]
  activities         Activity[]

  @@unique([yearStart, yearEnd])
  @@index([isActive])
  @@map("academic_periods")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 2. USER & AUTHENTICATION
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id        String    @id @default(cuid())
  nis       String?   @unique
  nisn      String?   @unique
  rfidCard  String?   @unique // UID / ID Kartu RFID Siswa/Pengurus (misal: "0014298172")
  name      String?
  email     String?   @unique
  password  String?
  image     String?   @db.Text
  role      Role      @default(STUDENT)
  division  Division?
  position  String? // Contoh: "Ketua Umum", "Koordinator", "Sekretaris I", "Anggota"
  kelas     String? // Contoh: "XII RPL 1"
  major     String? // Contoh: "RPL", "TKJ", "AKL", "DKV", "MPLB"
  gender    Gender?
  phone     String? // Nomor WhatsApp
  bio       String?   @db.Text
  isActive  Boolean   @default(true)
  deletedAt DateTime? // Soft delete flag

  // Periode Kepengurusan (opsional untuk siswa umum, diisi untuk pengurus kabinet)
  periodId String?
  period   AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi Aspirasi
  aspirations       Aspiration[]       @relation("UserAspirations")
  responses         Aspiration[]       @relation("ResponderAspirations")
  aspirationUpvotes AspirationUpvote[]

  // Relasi Konten & Proker
  activities   Activity[]
  workPrograms WorkProgram[]

  // Relasi Presensi Digital
  attendanceRecords         AttendanceRecord[]
  createdAttendanceSessions AttendanceSession[] @relation("SessionCreator")
  verifiedAttendances       AttendanceRecord[]  @relation("AttendanceVerifier")

  // Relasi Manajemen Tugas Anggota
  assignedTasks MemberTask[] @relation("AssignedTo")
  createdTasks  MemberTask[] @relation("TaskCreator")

  // Relasi Audit Log
  auditLogs AuditLog[] @relation("ActorAuditLogs")

  // Relasi Pencatat Pelanggaran
  violationRecords StudentViolation[] @relation("ViolationRecorder")

  @@index([role])
  @@index([division])
  @@index([periodId])
  @@index([isActive])
  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 3. ASPIRASI & ADVOKASI SISWA (KOTAK ASPIRASI DIGITAL)
// ═══════════════════════════════════════════════════════════════════════════════

model Aspiration {
  id             String           @id @default(cuid())
  title          String
  content        String           @db.Text
  category       String // Fasilitas, Akademik, Kegiatan, Tata Tertib, Ekstrakurikuler, dll.
  targetDivision Division         @default(KOMISI_B) // Default dikelola Komisi B (Aspirasi & Advokasi)
  status         AspirationStatus @default(PENDING)
  response       String?          @db.Text
  respondedAt    DateTime?
  isAnonymous    Boolean          @default(false)
  isPublic       Boolean          @default(true) // Apakah tampil di feed aspirasi publik
  attachmentUrl  String?          @db.Text // Bukti foto pendukung aspirasi
  upvotesCount   Int              @default(0) // Cache hitungan upvote siswa

  // Siswa pengirim
  userId String
  user   User   @relation("UserAspirations", fields: [userId], references: [id], onDelete: Cascade)

  // Pengurus penanggap
  respondedById String?
  respondedBy   User?   @relation("ResponderAspirations", fields: [respondedById], references: [id], onDelete: SetNull)

  // Timeline / History Status Aspirasi
  timeline AspirationTimeline[]
  upvotes  AspirationUpvote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([targetDivision])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("aspirations")
}

model AspirationTimeline {
  id            String           @id @default(cuid())
  aspirationId  String
  aspiration    Aspiration       @relation(fields: [aspirationId], references: [id], onDelete: Cascade)
  status        AspirationStatus
  note          String?          @db.Text
  changedByName String? // Nama aktor pengubah status
  createdAt     DateTime         @default(now())

  @@index([aspirationId])
  @@map("aspiration_timelines")
}

model AspirationUpvote {
  id           String     @id @default(cuid())
  aspirationId String
  aspiration   Aspiration @relation(fields: [aspirationId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([aspirationId, userId])
  @@index([aspirationId])
  @@index([userId])
  @@map("aspiration_upvotes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 4. PROGRAM KERJA (PROKER) & ANGGARAN
// ═══════════════════════════════════════════════════════════════════════════════

model WorkProgram {
  id              String       @id @default(cuid())
  title           String
  description     String       @db.Text
  division        Division
  targetPeriod    String // Contoh: "Mei 2026" / "Semester Ganjil"
  budget          Float?       @default(0) // Anggaran Rencana (Legacy & Quick Access)
  budgetPlanned   Float?       @default(0) // Rencana Anggaran Biaya (RAB)
  budgetRealized  Float?       @default(0) // Realisasi Anggaran Terpakai
  status          ProkerStatus @default(PLANNED)
  personInCharge  String? // Penanggung Jawab Proker
  proposalUrl     String?      @db.Text // Link Dokumen Proposal
  lpjUrl          String?      @db.Text // Link Dokumen LPJ
  evaluationNotes String?      @db.Text // Catatan evaluasi Komisi D MPK & Pembina

  // Periode Kepengurusan
  periodId String?
  period   AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  // Author / Penanggung jawab akun
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Relasi Turunan (Kegiatan Publikasi & Tugas Anggota)
  activities Activity[]
  tasks      MemberTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([division])
  @@index([status])
  @@index([periodId])
  @@map("work_programs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 5. KEGIATAN, ARTIKEL, DOKUMENTASI & GALERI (CMS)
// ═══════════════════════════════════════════════════════════════════════════════

model Activity {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  excerpt       String?    @db.Text
  content       String     @db.Text
  coverImage    String?    @db.Text
  galleryImages String[]   @default([])
  category      String // Olahraga, Seni, Keagamaan, Kepemimpinan, Lingkungan, dll.
  division      Division   @default(GENERAL)
  status        PostStatus @default(PUBLISHED)
  isFeatured    Boolean    @default(false)
  eventDate     DateTime?
  location      String?
  views         Int        @default(0)

  // Hubungan ke Program Kerja & Periode
  prokerId    String?
  workProgram WorkProgram?    @relation(fields: [prokerId], references: [id], onDelete: SetNull)
  periodId    String?
  period      AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([division])
  @@index([status])
  @@index([isFeatured])
  @@index([periodId])
  @@index([eventDate])
  @@map("activities")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 6. STRUKTUR ORGANISASI KABINET (ORGANIZATION STRUCTURE)
// ═══════════════════════════════════════════════════════════════════════════════

model StructureMember {
  id           String    @id @default(cuid())
  name         String
  role         String // Contoh: "Ketua Umum", "Koordinator", "Kepala Sekolah"
  badge        String // Contoh: "Ketua OSIS", "Sekbid 1", "Pelindung"
  photo        String?   @db.Text
  level        Int       @default(1) // 1: Kepsek, 2: Kesiswaan & Pembina, 3: Ketua/Wakil, 4: Sekre/Bend, 5: Sekbid/Komisi
  orgType      String    @default("SHARED") // SHARED, OSIS, MPK, DEWAN_PEMBINA
  divisionCode Division?
  order        Int       @default(0)
  instagramUrl String?
  linkedinUrl  String?
  isActive     Boolean   @default(true)

  // Periode Kepengurusan
  periodId String?
  period   AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgType])
  @@index([level])
  @@index([order])
  @@index([periodId])
  @@map("structure_members")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 7. SISTEM PRESENSI DIGITAL (ATTENDANCE SYSTEM)
// ═══════════════════════════════════════════════════════════════════════════════

model AttendanceSession {
  id             String         @id @default(cuid())
  title          String // Contoh: "Rapat Pleno Triwulan I", "Piket Ruang OSIS Rabu"
  description    String?        @db.Text
  type           AttendanceType @default(MEETING)
  targetDivision Division       @default(GENERAL) // Target peserta (GENERAL / OSIS / MPK / Sekbid tertentu)
  location       String? // Contoh: "Ruang Rapat OSIS-MPK", "Aula SMKN 11"
  date           DateTime       @default(now())
  startTime      String? // Contoh: "13:30"
  endTime        String? // Contoh: "16:00"
  passcode       String? // Kode OTP / PIN 6-digit untuk scan mandiri anggota
  qrToken        String?        @unique // Token QR Code dinamis untuk scan presensi
  isOpen         Boolean        @default(true) // Status sesi buka / tutup

  // Periode Kepengurusan
  periodId String?
  period   AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  createdById String
  creator     User   @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetDivision])
  @@index([date])
  @@index([isOpen])
  @@index([periodId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      AttendanceStatus @default(PRESENT)
  checkInTime DateTime         @default(now())
  notes       String?          @db.Text // Alasan izin/sakit atau catatan kehadiran
  proofImage  String?          @db.Text // Foto bukti izin / surat dokter / selfie presensi

  // Verifikasi oleh Sekretaris / Admin
  isVerified   Boolean   @default(true)
  verifiedById String?
  verifiedBy   User?     @relation("AttendanceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId]) // Setiap anggota hanya punya 1 record per sesi
  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@map("attendance_records")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 8. SISTEM MANAJEMEN TUGAS ANGGOTA (MEMBER TASKS ASSIGNMENT)
// ═══════════════════════════════════════════════════════════════════════════════

model MemberTask {
  id          String       @id @default(cuid())
  title       String // Contoh: "Buat Desain Banner Porseni", "Rekap Anggaran Kas Bulan Maret"
  description String       @db.Text
  division    Division // Divisi terkait (Sekbid / Komisi)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?

  // Relasi ke Proker spesifik (opsional)
  workProgramId String?
  workProgram   WorkProgram? @relation(fields: [workProgramId], references: [id], onDelete: SetNull)

  // Anggota yang ditugaskan
  assignedToId String
  assignedTo   User   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)

  // Pembuat tugas (Koordinator / Ketua / Sekretaris)
  createdById String
  creator     User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  // Submission & Review
  submissionNote String?   @db.Text
  submissionLink String?   @db.Text // Link Google Drive / Figma / File laporan
  reviewNote     String?   @db.Text // Feedback evaluator
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([division])
  @@index([assignedToId])
  @@index([status])
  @@index([workProgramId])
  @@map("member_tasks")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 9. AUDIT LOGS & SECURITY AUDIT TRAIL
// ═══════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entity      String // Contoh: "Aspiration", "User", "WorkProgram", "Attendance"
  entityId    String?
  description String      @db.Text
  metadata    Json? // Snapshot data perubahan (sebelum & sesudah)
  ipAddress   String?
  userAgent   String?

  actorId String?
  actor   User?   @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 10. PENCATAT PELANGGARAN SISWA (STUDENT VIOLATION TRACKER)
// ═══════════════════════════════════════════════════════════════════════════════

enum ViolationSeverity {
  RINGAN @map("ringan") // Pelanggaran ringan (misal: tidak mengucapkan salam)
  SEDANG @map("sedang") // Pelanggaran sedang (misal: tidak berseragam lengkap)
  BERAT  @map("berat") // Pelanggaran berat (misal: berkelahi, tidak hadir sapa pagi berulang)

  @@map("violation_severities")
}

model StudentViolation {
  id             String            @id @default(cuid())
  studentName    String // Nama siswa (tidak harus punya akun)
  studentClass   String // Kelas, contoh: "XII RPL 1"
  violationType  String // Jenis pelanggaran, contoh: "Tidak hadir Sapa Pagi"
  context        String? // Konteks kegiatan, contoh: "Sapa Pagi", "Upacara", "Piket Danus"
  notes          String?           @db.Text // Catatan tambahan petugas
  severity       ViolationSeverity @default(RINGAN)
  date           DateTime          @default(now()) // Tanggal pelanggaran
  pointDeduction Int               @default(0) // Pengurangan poin (jika berlaku)

  // Petugas pencatat
  recordedById String?
  recordedBy   User?   @relation("ViolationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentClass])
  @@index([violationType])
  @@index([severity])
  @@index([date])
  @@index([recordedById])
  @@map("student_violations")
}
